#!/bin/bash
#SBATCH --job-name=within_subject_slope
#SBATCH --output=/oak/stanford/groups/russpold/data/uh2/aim1/analysis_code/survey_medley_code/log/slope_maps_%A_%a.out
#SBATCH --error=/oak/stanford/groups/russpold/data/uh2/aim1/analysis_code/survey_medley_code/log/slope_maps_%A_%a.err
#SBATCH --time=03:00:00
#SBATCH -p russpold,hns,normal
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G

PROJECT_ROOT="/oak/stanford/groups/russpold/data/uh2/aim1/analysis_code/survey_medley_code"
SCRIPT_DIR="$PROJECT_ROOT/analyses/within_subject_brain_behavior_by_questionnaire"
UV_SETUP="$PROJECT_ROOT/setup_uv_sherlock.sh"

source $UV_SETUP

uv --directory "$PROJECT_ROOT" run "$SCRIPT_DIR/subject_slope_contrasts.py"
